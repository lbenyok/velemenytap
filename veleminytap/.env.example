# Supabase project connection.
# Get these from the project's Connect dialog in the Supabase dashboard
# (or from the Supabase MCP server once the project is linked).
# Copy this file to .env.local and fill in real values — .env.local is gitignored.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses Row Level Security — never expose to the browser,
# never prefix with NEXT_PUBLIC_, never commit a real value.
SUPABASE_SECRET_KEY=

# Base URL of this app, used to build absolute auth redirect links
# (email confirmation, etc). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (https://resend.com/api-keys). Used for negative-feedback alert
# emails to org owners/admins/managers. Optional in dev -- when unset,
# alert sending is skipped with a console warning instead of failing.
RESEND_API_KEY=
# Must be on a domain verified in Resend for production. Without your own
# verified domain, Resend's shared onboarding@resend.dev sender only
# delivers to the email address that owns the API key.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Sentry (https://sentry.io). Error monitoring for both client and server.
# A DSN is not a secret (it's fine to expose to the browser), which is why
# it's NEXT_PUBLIC_ -- it only lets a client report events, not read them.
# Optional: Sentry.init() with an empty dsn is a documented no-op, so the
# app runs fine without one.
NEXT_PUBLIC_SENTRY_DSN=
